# Copy to dev.env (gitignored) and choose your own values. Dev cluster only.
POSTGRES_PASSWORD=change-me-admin
ARENA_ADMIN_DSN=postgresql://postgres:change-me-admin@adk-leak-arena-postgres:5432/memshield
# memshield_app is created by `leak-arena seed` with the development password from
# sql/init_arena.sql; rotate it with ALTER ROLE memshield_app PASSWORD '...' and update here.
ARENA_DB_DSN=postgresql://memshield_app:memshield_pass@adk-leak-arena-postgres:5432/memshield
